# 复制本文件为 .env 后填值。.env 已被 .gitignore 忽略，禁止入库。
# 环境依赖与提交门禁的完整说明见 docs/development.md。

# ── 提 PR（GitHub API 方式）────────────────────────────────────────────
# fine-grained PAT，权限 pull_requests:write + contents:read
GITHUB_PR_TOKEN=

# ── 跑评测（scripts/run-eval.sh）─────────────────────────────────────
# 被测 agent 的无头调用命令模板，占位符：{input_file} {workspace} {output_file}
AGENT_CMD=
# 可选：自动评分命令模板（未设置则人工 judge），占位符 {task} {ws} {rubric} {output}
JUDGE_CMD=

# ── 同步到目标仓库（scripts/sync-to-target.sh）───────────────────────
# 对各目标仓库有 write 权限的 PAT
SYNC_TOKEN=
# 可选：同步目标，逗号分隔可写多个；单个目标可用 owner/repo#分支 单独指定基线分支
# 例：TARGET_REPOS="web5/web_system,web5/other#main"
# 留空则回退到 TARGET_REPO（单目标兼容项），再回退到默认 web5/web_system
TARGET_REPOS=
# 可选：未用 #分支 指定时的基线分支（默认 master）
TARGET_BASE=
